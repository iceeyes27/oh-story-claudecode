{
  "version": 1,
  "target": "B03",
  "source_hash": "ee11d53476ebcf3c1ab2b03fd9155b719f8b17c2847a6cb382b2983a4b3350b4",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "深夜，城堡走廊。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "宵禁钟声敲过很久了。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "埃德蒙从三楼那间空教室出来，怀里揣着三张废掉的符纸。"
        },
        {
          "id": "1-04",
          "line": 5,
          "text": "宿舍里有加文的呼噜，画符得找没人的地方。"
        },
        {
          "id": "1-05",
          "line": 7,
          "text": "走到拐角，他靠在石柱阴影里揉额角，摸出手机滑开。"
        },
        {
          "id": "1-06",
          "line": 9,
          "text": "指尖在音频缓存里点了一下。"
        },
        {
          "id": "1-07",
          "line": 11,
          "text": "一记吉他扫弦流出来，跟着是沙哑的中文男声。"
        },
        {
          "id": "1-08",
          "line": 13,
          "text": "“曾经跨过山和大海……”"
        },
        {
          "id": "1-09",
          "line": 15,
          "text": "半秒。"
        },
        {
          "id": "1-10",
          "line": 15,
          "text": "他按下侧键掐断。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "“你在跟谁说话？”"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "埃德蒙转过身。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "姜小满抱着厚厚的《魔法史》立在暗处。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "“那不是英语。"
        },
        {
          "id": "2-05",
          "line": 23,
          "text": "那是歌。"
        },
        {
          "id": "2-06",
          "line": 23,
          "text": "你身上有东西在唱歌。”"
        },
        {
          "id": "2-07",
          "line": 25,
          "text": "“小满同学，宵禁乱逛，费尔奇会关你禁闭。”"
        },
        {
          "id": "2-08",
          "line": 27,
          "text": "“少打马虎眼。”"
        },
        {
          "id": "2-09",
          "line": 29,
          "text": "她逼近一步。"
        },
        {
          "id": "2-10",
          "line": 31,
          "text": "“你在车上就自言自语。"
        },
        {
          "id": "2-11",
          "line": 31,
          "text": "今天锅底那张纸根本不是炼金术的画法。"
        },
        {
          "id": "2-12",
          "line": 31,
          "text": "现在拿出来，不然我这就去找费尔奇，说你私藏违禁品。”"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 43,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "埃德蒙没说话。"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "袖口里的手机忽然震动了一下。"
        },
        {
          "id": "3-03",
          "line": 37,
          "text": "一道清脆的女声在寂静的走廊里响起来："
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "“这位小满小姐，请不要冲动。"
        },
        {
          "id": "3-05",
          "line": 39,
          "text": "根据安全防卫守则，近距离用尖锐木棍指着他人是很不礼貌的行为，傻妞对您没有恶意。”"
        },
        {
          "id": "3-06",
          "line": 41,
          "text": "姜小满整个人吓得倒退半步，魔杖差点脱手，眼睛瞪得滚圆："
        },
        {
          "id": "3-07",
          "line": 43,
          "text": "“谁？！"
        },
        {
          "id": "3-08",
          "line": 43,
          "text": "谁在说话？！"
        },
        {
          "id": "3-09",
          "line": 43,
          "text": "哪个女孩子藏在你衣服里？！”"
        }
      ]
    }
  ]
}