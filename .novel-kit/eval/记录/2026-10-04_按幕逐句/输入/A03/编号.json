{
  "version": 1,
  "target": "A03",
  "source_hash": "bceb60aaaeac3e08072d6d0185b035d44abcb2f93a191193a3780de2221591bf",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "玛莎把埃德蒙拉到避风的屋檐下，替他拢紧了粗呢斗篷的领口。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "她从内衬口袋摸出一只粗布旧袋，解开缠了三圈的细麻绳。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "两枚金加隆滚进埃德蒙掌心，微微一沉。"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "跟着取出来的，是一小卷用红棉线扎得整整齐齐的六张十镑英镑纸币。"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "“这是你下学期要补的耗材钱。”"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "玛莎目光掠过来往的旅客，轻声嘱咐："
        },
        {
          "id": "1-07",
          "line": 13,
          "text": "“开学那趟置办齐整，柜子里还稳稳留着八个加隆，是全家的救急底子，谁也不准动。”"
        },
        {
          "id": "1-08",
          "line": 15,
          "text": "她把那一小卷英镑压进埃德蒙手里。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 21,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "“这是妈妈这个月多接了四件翻领大衣的针线活挣来的。"
        },
        {
          "id": "2-02",
          "line": 17,
          "text": "今天带你去对角巷，先把缺的药草和羊皮纸买齐。”"
        },
        {
          "id": "2-03",
          "line": 19,
          "text": "埃德蒙握紧掌心，金属的凉意与粗糙纸币贴在一起。"
        },
        {
          "id": "2-04",
          "line": 21,
          "text": "“我知道，妈妈。"
        },
        {
          "id": "2-05",
          "line": 21,
          "text": "救急的钱不动。”"
        }
      ]
    }
  ]
}