{
  "version": 1,
  "target": "A04",
  "source_hash": "7ff49362993d89c2618669a701f3630ef7499bc80976a10a0030d281ae1dcf8d",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "两人走向街口时，数十米外的服装店檐下，一道瘦小的身影撑着油纸伞立在雪里。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "姜小满怀里抱着几卷新宣纸。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "她一眼瞧见了并肩行走的埃德蒙与红发学长。"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "随后，她见埃德蒙微微侧头，对着自己的左边袖口轻声说了一句什么。"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "姜小满眉头微蹙，长睫在雪风里眨动一下，轻哼一声收拢伞沿，快步隐入雪幕中。"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "傍晚，红砖巷的小屋里。"
        },
        {
          "id": "1-07",
          "line": 13,
          "text": "壁炉里干柴烧得噼啪响，满室暖意。"
        },
        {
          "id": "1-08",
          "line": 15,
          "text": "埃德蒙将采购齐整的课本、药草和羊皮纸码在桌上。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 21,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "不仅无一遗漏，兑来的加隆连同母亲给的两枚花得见了底，那卷英镑还剩四张十镑钞票，兜里只叮当揣着几个找零的西可。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "玛莎端着土豆牛肉汤出来，看着桌上的余钱，一时愣住。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "“这孩子从小把钱攥得紧。”"
        },
        {
          "id": "2-04",
          "line": 21,
          "text": "亚瑟乐呵呵摸着脑袋，大口喝汤。"
        }
      ]
    }
  ]
}