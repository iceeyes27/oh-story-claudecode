{
  "version": 1,
  "target": "B04",
  "source_hash": "ac9165764128cff94e37a976e3168e204238efaf2c8375d905e04af0ec3fc0af",
  "beats": [
    {
      "no": 1,
      "label": "第3段起",
      "start_line": 1,
      "end_line": 17,
      "sentences": [
        {
          "id": "1-01",
          "line": 3,
          "text": "一个学期熬到头，九又四分之三站台的蒸汽还未散尽，伦敦落下了初冬的湿雪。"
        },
        {
          "id": "1-02",
          "line": 5,
          "text": "雪水混着冷雨，把国王十字车站外的红砖墙浇得深暗。"
        },
        {
          "id": "1-03",
          "line": 7,
          "text": "埃德蒙拖着皮箱走出拱门。"
        },
        {
          "id": "1-04",
          "line": 9,
          "text": "亚瑟・霍尔特搓着冻红的双手站在石柱旁，玛莎跟在他身后。"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "一见儿子出来，亚瑟快步迎上前，接过了沉重的皮箱。"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "“长高了，脸也见肉了。”"
        },
        {
          "id": "1-07",
          "line": 13,
          "text": "父亲满是胡茬的脸上露出宽厚的笑意。"
        },
        {
          "id": "1-08",
          "line": 15,
          "text": "玛莎把埃德蒙拉到避风的屋檐下，替他拢紧了粗呢斗篷的领口。"
        },
        {
          "id": "1-09",
          "line": 17,
          "text": "她从内衬口袋摸出一只粗布旧袋，解开缠了三圈的细麻绳。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第19段起",
      "start_line": 19,
      "end_line": 33,
      "sentences": [
        {
          "id": "2-01",
          "line": 19,
          "text": "两枚金加隆滚进埃德蒙掌心，微微一沉。"
        },
        {
          "id": "2-02",
          "line": 21,
          "text": "跟着取出来的，是一小卷用红棉线扎得整整齐齐的六张十镑英镑纸币。"
        },
        {
          "id": "2-03",
          "line": 23,
          "text": "“这是你下学期要补的耗材钱。”"
        },
        {
          "id": "2-04",
          "line": 25,
          "text": "玛莎目光掠过来往的旅客，轻声嘱咐："
        },
        {
          "id": "2-05",
          "line": 27,
          "text": "“开学那趟置办齐整，柜子里还稳稳留着八个加隆，是全家的救急底子，谁也不准动。”"
        },
        {
          "id": "2-06",
          "line": 29,
          "text": "她把那一小卷英镑压进埃德蒙手里。"
        },
        {
          "id": "2-07",
          "line": 31,
          "text": "“这是妈妈这个月多接了四件翻领大衣的针线活挣来的。"
        },
        {
          "id": "2-08",
          "line": 31,
          "text": "今天带你去对角巷，先把缺的药草和羊皮纸买齐。”"
        },
        {
          "id": "2-09",
          "line": 33,
          "text": "埃德蒙握紧掌心，金属的凉意与粗糙纸币贴在一起。"
        }
      ]
    },
    {
      "no": 3,
      "label": "第35段起",
      "start_line": 35,
      "end_line": 45,
      "sentences": [
        {
          "id": "3-01",
          "line": 35,
          "text": "“我知道，妈妈。"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "救急的钱不动。”"
        },
        {
          "id": "3-03",
          "line": 37,
          "text": "穿过破釜酒吧后院的天井，砖墙向两侧裂开。"
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "即使落着湿雪，对角巷的青石板街上依旧挤满了戴斗篷的巫师。"
        },
        {
          "id": "3-05",
          "line": 41,
          "text": "两侧店铺橱窗挂着冬青树枝，雪地里落满猫头鹰爪印。"
        },
        {
          "id": "3-06",
          "line": 43,
          "text": "玛莎约了侧巷相熟的铺子，去送这月翻新好的袍子，说好办完事到破釜酒吧碰头。"
        },
        {
          "id": "3-07",
          "line": 45,
          "text": "埃德蒙没有急着拐进旧书店，径直走向街道尽头的交叉路口。"
        }
      ]
    }
  ]
}