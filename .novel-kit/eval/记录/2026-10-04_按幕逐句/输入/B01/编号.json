  "version": 1,
  "target": "B01",
  "source_hash": "66fd13a7a67f89e94d6eee66a64fa1a4176a647b218dd9d6817dda5c75d6477f",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "套着校徽茶巾的托比小跑过来，深深鞠躬，长耳朵拖在地上。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "“赫奇帕奇的小先生！"
        },
        {
          "id": "1-03",
          "line": 3,
          "text": "托比马上给您拿新鲜的冷牛肉馅饼和烤土豆！”"
        },
        {
          "id": "1-04",
          "line": 5,
          "text": "“别拿那些了。”"
        },
        {
          "id": "1-05",
          "line": 7,
          "text": "埃德蒙蹲下身。"
        },
        {
          "id": "1-06",
          "line": 9,
          "text": "“托比，你们每天做饭，就这么几道菜谱？”"
        },
        {
          "id": "1-07",
          "line": 11,
          "text": "托比的耳朵耷拉下来。"
        },
        {
          "id": "1-08",
          "line": 13,
          "text": "“霍格沃茨的菜谱是一千年前定下的。"
        },
        {
          "id": "1-09",
          "line": 13,
          "text": "小精灵必须守规矩！”"
        },
        {
          "id": "1-10",
          "line": 15,
          "text": "“土豆烤四十分钟，鳕鱼炸两遍！"
        },
        {
          "id": "1-11",
          "line": 15,
          "text": "改了规矩，托比就要把脑袋塞进烤箱受罚！”"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 29,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "“行了，先停下，没让你改规矩。”"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "埃德蒙拽住小精灵的领子，把它从灶台前拉开。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "嘴上嫌难吃，真看着被死册子折腾成这样，他到底不落忍。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "“创始人定的是大菜。"
        },
        {
          "id": "2-05",
          "line": 23,
          "text": "他们禁过在大菜旁边添一碟蘸料和小配菜吗。”"
        },
        {
          "id": "2-06",
          "line": 25,
          "text": "托比眨了眨大眼睛，耳朵跟着动了动。"
        },
        {
          "id": "2-07",
          "line": 27,
          "text": "“……"
        },
        {
          "id": "2-08",
          "line": 27,
          "text": "这确实没禁过。"
        },
        {
          "id": "2-09",
          "line": 27,
          "text": "可是除了盐和胡椒，还能加什么？”"
        },
        {
          "id": "2-10",
          "line": 29,
          "text": "“你们这儿，有没有送来了却一直没人点过的东西。”"
        }
      ]
    }
  ]
}