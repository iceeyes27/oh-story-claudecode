{
  "version": 1,
  "target": "B02",
  "source_hash": "0c9554d97b8cc712d2293fa4d386a9079eb2047a484bd440a62fa322c31d3579",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "傍晚，大礼堂。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "菜品传送就位，这一次没有水煮卷心菜的酸气。"
        },
        {
          "id": "1-03",
          "line": 3,
          "text": "一股浓烈的焦香扫过整个大厅。"
        },
        {
          "id": "1-04",
          "line": 5,
          "text": "加文猛地弹起来。"
        },
        {
          "id": "1-05",
          "line": 7,
          "text": "“什么味儿？！”"
        },
        {
          "id": "1-06",
          "line": 9,
          "text": "赫奇帕奇长桌中央摆着三大银盆红亮的肉丁，旁边架着一口咕嘟翻滚的小坩埚。"
        },
        {
          "id": "1-07",
          "line": 11,
          "text": "爱丽丝用银叉戳了一颗鸡肉塞进嘴里，眼睛瞬间瞪大。"
        },
        {
          "id": "1-08",
          "line": 13,
          "text": "“这是什么？”"
        },
        {
          "id": "1-09",
          "line": 15,
          "text": "“不知道！”"
        },
        {
          "id": "1-10",
          "line": 15,
          "text": "加文一勺子下去把盘子堆成小山，“抢了再说！”"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "香味顺着过道飘出去。"
        },
        {
          "id": "2-02",
          "line": 17,
          "text": "拉文克劳的学生伸长脖子，格兰芬多一个红头发的高年级男生端着空盘挤过来。"
        },
        {
          "id": "2-03",
          "line": 19,
          "text": "“嘿，赫奇帕奇的，别吃独食！”"
        },
        {
          "id": "2-04",
          "line": 21,
          "text": "“不分！"
        },
        {
          "id": "2-05",
          "line": 21,
          "text": "拿布丁换都不换！”"
        },
        {
          "id": "2-06",
          "line": 23,
          "text": "不过十分钟，半个礼堂的学生在赫奇帕奇桌后头排起了队。"
        },
        {
          "id": "2-07",
          "line": 25,
          "text": "人群外，姜小满挤上前盛了一勺菜，端起盘子时凑近打量那口小坩埚，正巧瞟见锅底压着的那张黄纸露出的符线一角。"
        },
        {
          "id": "2-08",
          "line": 25,
          "text": "她的目光随即穿过人墙，带着狐疑落在一边喝汤的埃德蒙身上。"
        },
        {
          "id": "2-09",
          "line": 27,
          "text": "侧门开了。"
        },
        {
          "id": "2-10",
          "line": 29,
          "text": "没有人喊，可那一片的动静自己矮了下去。"
        },
        {
          "id": "2-11",
          "line": 31,
          "text": "斯内普站在门口，目光落在操作台中央那口冒着热汽的小坩埚上。"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 47,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "“霍尔特先生。”"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "他的声音不高，小精灵们缩到面粉袋后面去了。"
        },
        {
          "id": "3-03",
          "line": 37,
          "text": "“你用熬制魔药的器皿，煮牲口的内脏。”"
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "“教授，这是学生自费买的备用锅，昨晚刷过三遍，没沾过药水。”"
        },
        {
          "id": "3-05",
          "line": 41,
          "text": "“那是魔药学的器具。”"
        },
        {
          "id": "3-06",
          "line": 41,
          "text": "斯内普往前走了两步，“不是你的饭碗。”"
        },
        {
          "id": "3-07",
          "line": 43,
          "text": "“教授教导过我们，魔药的精髓在于控温。”"
        },
        {
          "id": "3-08",
          "line": 45,
          "text": "埃德蒙的语气温和得挑不出毛病。"
        },
        {
          "id": "3-09",
          "line": 47,
          "text": "“学生只是在琢磨金属导热的边界。"
        },
        {
          "id": "3-10",
          "line": 47,
          "text": "物尽其用，是赫奇帕奇的美德。”"
        }
      ]
    },
    {
      "no": 4,
      "label": "第49段起",
      "start_line": 49,
      "end_line": 63,
      "sentences": [
        {
          "id": "4-01",
          "line": 49,
          "text": "斯内普的目光往锅底挪了半寸。"
        },
        {
          "id": "4-02",
          "line": 51,
          "text": "身后传来轻柔的脚步声。"
        },
        {
          "id": "4-03",
          "line": 53,
          "text": "邓布利多从托盘里拈起一块鸡肉，看了看，又放回盘子。"
        },
        {
          "id": "4-04",
          "line": 55,
          "text": "“闻着真不错，西弗勒斯。"
        },
        {
          "id": "4-05",
          "line": 55,
          "text": "要不要来一碗？”"
        },
        {
          "id": "4-06",
          "line": 57,
          "text": "斯内普的指节捏得发白。"
        },
        {
          "id": "4-07",
          "line": 59,
          "text": "“不用了，阿不思。”"
        },
        {
          "id": "4-08",
          "line": 61,
          "text": "他转过身，声音压得很低，一个字一个字往外送。"
        },
        {
          "id": "4-09",
          "line": 63,
          "text": "“霍尔特先生。"
        },
        {
          "id": "4-10",
          "line": 63,
          "text": "要是再让我看到你用熬魔药的锅煮这些东西，我就扣你学院二十分。”"
        }
      ]
    },
    {
      "no": 5,
      "label": "第65段起",
      "start_line": 65,
      "end_line": 69,
      "sentences": [
        {
          "id": "5-01",
          "line": 65,
          "text": "门在身后合上。"
        },
        {
          "id": "5-02",
          "line": 67,
          "text": "邓布利多没有跟着走。"
        },
        {
          "id": "5-03",
          "line": 67,
          "text": "他弯下腰，就着烛光去看那口坩埚的底部，那张黄纸的边角正从锅沿下露出来一条。"
        },
        {
          "id": "5-04",
          "line": 69,
          "text": "他看了很久，什么也没说，端着一小碗鸡肉慢慢走了。"
        }
      ]
    }
  ]
}