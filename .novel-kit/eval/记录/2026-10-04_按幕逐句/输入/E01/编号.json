{
  "version": 1,
  "target": "E01",
  "source_hash": "07d91edb1358501b6c0e89186f2b39abeba1c6d4cb552884b5ec840e7dae550c",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "雨点砸在漏风的破木顶上，噼里啪啦地响。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "陈放睁开眼，下意识抬手去摸枕边的手机。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "指尖刚一抬起，他就僵住了。"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "视线里伸出来的，根本不是成年人的手。"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "苍白，枯瘦，指节上落着冻疮留下的暗紫疤痕。"
        },
        {
          "id": "1-06",
          "line": 9,
          "text": "他试着蜷了蜷手指，关节发僵，倒还听使唤。"
        },
        {
          "id": "1-07",
          "line": 11,
          "text": "他仰面躺着，身上套着一件洗得发硬的粗布睡衫，又宽又大，领口松垮地偏向一侧，露出凸起的锁骨与细瘦的颈子。"
        },
        {
          "id": "1-08",
          "line": 11,
          "text": "这分明是个十来岁、刚退了高烧的孩子。"
        },
        {
          "id": "1-09",
          "line": 13,
          "text": "最后的记忆，是出租屋里亮着的电脑屏幕。"
        },
        {
          "id": "1-10",
          "line": 13,
          "text": "凌晨连轴改方案，胸口突然一阵撕裂剧痛，尖锐耳鸣炸开，眼前黑透，一头栽倒在键盘上，连呼救都来不及。"
        },
        {
          "id": "1-11",
          "line": 15,
          "text": "就这么没了？"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "陌生的记忆随即涌了上来。"
        },
        {
          "id": "2-02",
          "line": 17,
          "text": "埃德蒙·霍尔特，十一岁，在这间漏雨的破阁楼里高烧了整整三天。"
        },
        {
          "id": "2-03",
          "line": 17,
          "text": "正规药铺的退热魔药要价昂贵，家里那点从牙缝里抠出来的全部积蓄，被父母死死按着要留作明天的开学底子，谁也不敢动，只能靠母亲熬些便宜的干草药硬灌硬顶，险些把命给彻底熬干。"
        },
        {
          "id": "2-04",
          "line": 19,
          "text": "还没等他完全消化这具身躯的记忆，楼下突然传来一阵暴烈的拍门声与尖利的叫骂，震得天花板细缝里簌簌落下一层轻灰："
        },
        {
          "id": "2-05",
          "line": 21,
          "text": "“亚瑟·霍尔特！"
        },
        {
          "id": "2-06",
          "line": 21,
          "text": "给老子开门！”"
        },
        {
          "id": "2-07",
          "line": 23,
          "text": "“亚瑟，翻倒巷借来的钱必须退回去！"
        },
        {
          "id": "2-08",
          "line": 23,
          "text": "那些妖精沾不得！”"
        },
        {
          "id": "2-09",
          "line": 23,
          "text": "那是女人的声音，带着止不住的哭腔与惊恐。"
        },
        {
          "id": "2-10",
          "line": 25,
          "text": "“退？"
        },
        {
          "id": "2-11",
          "line": 25,
          "text": "怎么退！"
        },
        {
          "id": "2-12",
          "line": 25,
          "text": "八月三十一号了，明天一早就是九月一号，十一点前必须赶到国王十字车站！"
        },
        {
          "id": "2-13",
          "line": 25,
          "text": "退了钱，埃德蒙拿什么去买魔杖和课本？！”"
        },
        {
          "id": "2-14",
          "line": 25,
          "text": "男人的嗓音粗重嘶哑，急得直拍桌子。"
        },
        {
          "id": "2-15",
          "line": 27,
          "text": "陈放吸了口冷气，肋骨深处隐隐作痛。"
        },
        {
          "id": "2-16",
          "line": 29,
          "text": "枕头底下忽然硌着硬物。"
        },
        {
          "id": "2-17",
          "line": 31,
          "text": "他伸手探入薄薄的稻草枕下，掌心猛地一沉。"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 39,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "暗青色的外壳，触手冰冷而坚硬，边缘那道极其熟悉的微弧倒角，他闭着眼睛也能摸得出来。"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "那是他生前随身携带的工程测试机。"
        },
        {
          "id": "3-03",
          "line": 35,
          "text": "端侧轻量化模型是他亲手量化部署的，本地离线知识库也是他一点一点喂进去的。"
        },
        {
          "id": "3-04",
          "line": 37,
          "text": "发僵的细瘦指节还有些不听使唤，但凭着六年的肌肉记忆，他按着侧键与虚拟屏，逐位敲完了那一串数字。"
        },
        {
          "id": "3-05",
          "line": 39,
          "text": "屏幕泛起一层微弱的亮光，黑底上浮出几个还能勉强使用的图标。"
        },
        {
          "id": "3-06",
          "line": 39,
          "text": "其余大半应用都因电量枯竭而灰暗休眠，右上角那个电池图标已经泛着警示的猩红：1%。"
        }
      ]
    }
  ]
}