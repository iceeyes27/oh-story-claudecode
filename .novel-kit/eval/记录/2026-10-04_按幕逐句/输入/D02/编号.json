{
  "version": 1,
  "target": "D02",
  "source_hash": "1d68edd30e1cb4e66be6072b4a752988a21514b15223258a48f5514dbdebba6c",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "“五个金加隆？！”"
        },
        {
          "id": "1-02",
          "line": 1,
          "text": "格里普斯像是被割了肉一样尖叫起来，“老子今天连利息都没收着！"
        },
        {
          "id": "1-03",
          "line": 1,
          "text": "你这是明抢！”"
        },
        {
          "id": "1-04",
          "line": 3,
          "text": "陈放没有动怒，只是转过头，淡淡看了一眼门外连绵的夜雨："
        },
        {
          "id": "1-05",
          "line": 5,
          "text": "“不给也行。"
        },
        {
          "id": "1-06",
          "line": 5,
          "text": "明早对角巷古灵阁大厅开门，我就拿去让当值的掌柜听个明白。"
        },
        {
          "id": "1-07",
          "line": 5,
          "text": "您猜总行会赏我几个加隆？”"
        },
        {
          "id": "1-08",
          "line": 7,
          "text": "格里普斯的尖叫瞬间卡在喉咙里，浑身像坠入了冰窖。"
        },
        {
          "id": "1-09",
          "line": 9,
          "text": "他死死盯着那个神色冷漠的男孩，又看了一眼对方手里那块冰冷的铁方块。"
        },
        {
          "id": "1-10",
          "line": 9,
          "text": "他知道对方不是在吓唬他——只要这段声音明早出现在古灵阁大厅，别说藏在翻倒巷的全部积蓄，他连骨头渣子都会被清算执事碾碎了喂火龙。"
        },
        {
          "id": "1-11",
          "line": 9,
          "text": "他输不起，更赌不起！"
        },
        {
          "id": "1-12",
          "line": 11,
          "text": "在暴怒与恐惧的剧烈撕扯下，格里普斯胸口起伏得像个破风箱，枯瘦的爪子抖得几乎握不住钱袋。"
        },
        {
          "id": "1-13",
          "line": 11,
          "text": "最终，他咬碎了尖牙，从腰间摸出五枚沉甸甸的金加隆，发泄般狠狠砸在桌面上！"
        },
        {
          "id": "1-14",
          "line": 13,
          "text": "当啷！"
        },
        {
          "id": "1-15",
          "line": 13,
          "text": "五枚金加隆在木桌上剧烈弹跳了两下。"
        },
        {
          "id": "1-16",
          "line": 15,
          "text": "陈放没有说话。"
        },
        {
          "id": "1-17",
          "line": 15,
          "text": "他只是伸出手，将滚到桌角的金加隆一枚一枚拢进掌心，然后侧开半步，露身后那扇空荡荡、往屋里灌着冷雨的破门道。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "昏暗的烛光把男孩细瘦的影子拉得很长，整间屋子里只剩下雨水落进铁罐的滴答声。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "格里普斯死死剜了他一眼，怀里紧紧抱着那八个本金加隆，再没敢吐出半句废话，带着两个同样后怕的打手，狼狈地钻进了门外阴冷的暴雨里。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "被踹坏的木门斜靠在门槛边，断裂的门闩晃荡着，冷风裹着雨沫顺着门缝往屋里飘。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "玛莎扶着墙走过来，一把将他紧紧抱进怀里，单薄的肩膀抖得厉害。"
        },
        {
          "id": "2-05",
          "line": 23,
          "text": "她什么也没问，只是伸出粗糙发凉的手掌，一遍遍抚摸他的额头，试着高烧退了没有。"
        },
        {
          "id": "2-06",
          "line": 25,
          "text": "亚瑟还僵在桌角，手里死死攥着那张撕碎的羊皮纸残角，眼眶发红地看着自己的儿子：“埃德蒙……"
        },
        {
          "id": "2-07",
          "line": 25,
          "text": "你刚才说的那些……”"
        },
        {
          "id": "2-08",
          "line": 27,
          "text": "陈放没有出声。"
        },
        {
          "id": "2-09",
          "line": 27,
          "text": "他借着母亲拥抱的遮掩，将掌心里的黑色机身贴在胸口阴影处。"
        },
        {
          "id": "2-10",
          "line": 29,
          "text": "暗沉的屏幕底端跳出两行极细的小字。"
        },
        {
          "id": "2-11",
          "line": 29,
          "text": "机身贴在领口下，微弱的声音从听筒里漏出来，被门外的雨声遮得严严实实："
        },
        {
          "id": "2-12",
          "line": 31,
          "text": "“电量剩余百分之零点三……"
        },
        {
          "id": "2-13",
          "line": 31,
          "text": "即将触发强制关机。”"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 37,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "“挂起前台进程，锁死底层功耗。”"
        },
        {
          "id": "3-02",
          "line": 33,
          "text": "陈放唇齿微动，压低到极致的气音只有机身能捕捉，“转入最低功耗应急休眠，非物理按键不唤醒。"
        },
        {
          "id": "3-03",
          "line": 33,
          "text": "把对外口径记进防护条例：东方家传法器，我只略懂皮毛。”"
        },
        {
          "id": "3-04",
          "line": 35,
          "text": "“指令已确认……"
        },
        {
          "id": "3-05",
          "line": 35,
          "text": "魔杖共振数据与防护条例已暂存。"
        },
        {
          "id": "3-06",
          "line": 35,
          "text": "老板，傻妞转入深度待机了，在彻底断电前，一定要找到充能的方法呀……”"
        },
        {
          "id": "3-07",
          "line": 37,
          "text": "屏幕边缘最后一抹微光无声收拢，机身重归冰冷的静默。"
        }
      ]
    }
  ]
}