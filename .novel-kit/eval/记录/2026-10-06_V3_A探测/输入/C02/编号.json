{
 "version": 1,
 "target": "C02",
 "source_hash": "1a189dbff7c403c50723526ab47951f6a3f7877d422bc09deaad1e5af71de20d",
 "beats": [
  {
   "no": 1,
   "label": "第1段起",
   "start_line": 1,
   "end_line": 15,
   "sentences": [
    {
     "id": "1-01",
     "line": 1,
     "text": "比尔伸了个懒腰，往椅背上一靠。"
    },
    {
     "id": "1-02",
     "line": 3,
     "text": "“我当年进队靠追球，满场跑，追到脱力，队长说我光有蛮劲不会算。”"
    },
    {
     "id": "1-03",
     "line": 5,
     "text": "“后来才琢磨明白，追球一半靠腿，一半靠脑子。”"
    },
    {
     "id": "1-04",
     "line": 7,
     "text": "“你倒好，一上来就跳过蛮劲，直接上脑子。"
    },
    {
     "id": "1-05",
     "line": 7,
     "text": "别怕摔，摔几次就摸到门道了。”"
    },
    {
     "id": "1-06",
     "line": 9,
     "text": "“还有呢？”"
    },
    {
     "id": "1-07",
     "line": 11,
     "text": "比尔追着问。"
    },
    {
     "id": "1-08",
     "line": 13,
     "text": "“没了？”"
    },
    {
     "id": "1-09",
     "line": 15,
     "text": "“还有……”"
    }
   ]
  },
  {
   "no": 2,
   "label": "第17段起",
   "start_line": 17,
   "end_line": 31,
   "sentences": [
    {
     "id": "2-01",
     "line": 17,
     "text": "埃德蒙斟酌了一下。"
    },
    {
     "id": "2-02",
     "line": 19,
     "text": "“斯内普教授，收走了我的笔记本。”"
    },
    {
     "id": "2-03",
     "line": 21,
     "text": "比尔正喝茶，闻言呛了一下。"
    },
    {
     "id": "2-04",
     "line": 23,
     "text": "“斯内普？”"
    },
    {
     "id": "2-05",
     "line": 25,
     "text": "“他收你笔记本？”"
    },
    {
     "id": "2-06",
     "line": 27,
     "text": "“他不是只收那些乱涂乱画的本子吗？”"
    },
    {
     "id": "2-07",
     "line": 29,
     "text": "埃德蒙老实说：“我的本子，可能比乱涂乱画严重一点。”"
    },
    {
     "id": "2-08",
     "line": 31,
     "text": "“我在上面画了好多符。”"
    }
   ]
  },
  {
   "no": 3,
   "label": "第33段起",
   "start_line": 33,
   "end_line": 47,
   "sentences": [
    {
     "id": "3-01",
     "line": 33,
     "text": "“不是霍格沃茨教的那些。”"
    },
    {
     "id": "3-02",
     "line": 35,
     "text": "“是……"
    },
    {
     "id": "3-03",
     "line": 35,
     "text": "我自己瞎琢磨的。”"
    },
    {
     "id": "3-04",
     "line": 37,
     "text": "“画符？”"
    },
    {
     "id": "3-05",
     "line": 37,
     "text": "比尔眨眨眼，“我们家就我爸会画一点，给旧坩埚补漏。"
    },
    {
     "id": "3-06",
     "line": 37,
     "text": "你画的是什么符？”"
    },
    {
     "id": "3-07",
     "line": 39,
     "text": "埃德蒙摇头：“说不清楚，烧火的时候想让火旺一点。”"
    },
    {
     "id": "3-08",
     "line": 41,
     "text": "“后来伍德说，我那张符烧起来火苗是蓝的，他在球场边看见了，还以为是烟火。”"
    },
    {
     "id": "3-09",
     "line": 43,
     "text": "比尔笑得前仰后合：“画符画到伍德以为是烟火，你是头一个。”"
    },
    {
     "id": "3-10",
     "line": 45,
     "text": "“后来斯内普教授就收走了，说上课要用。”"
    },
    {
     "id": "3-11",
     "line": 45,
     "text": "埃德蒙说，“我知道他想看我画的是什么，可一直没敢去要。”"
    },
    {
     "id": "3-12",
     "line": 47,
     "text": "“斯内普看着凶，其实护短。”"
    },
    {
     "id": "3-13",
     "line": 47,
     "text": "比尔点头，“真觉得你有问题，早找你谈话了。"
    },
    {
     "id": "3-14",
     "line": 47,
     "text": "你回头大大方方去要，他不给，就说是我让你去的。”"
    }
   ]
  },
  {
   "no": 4,
   "label": "第49段起",
   "start_line": 49,
   "end_line": 63,
   "sentences": [
    {
     "id": "4-01",
     "line": 49,
     "text": "“谢谢学长。”"
    },
    {
     "id": "4-02",
     "line": 51,
     "text": "“谢什么，我护不了你一辈子，但能帮你讨本子的时候，我还是会伸手。”"
    },
    {
     "id": "4-03",
     "line": 53,
     "text": "他放下茶杯，笑了：“我就知道你不是个躲事的。"
    },
    {
     "id": "4-04",
     "line": 53,
     "text": "去年领你进赫奇帕奇，你瘦得跟竹竿似的，我还担心你挨欺负，结果你倒好，连教授的本子都敢乱涂。”"
    },
    {
     "id": "4-05",
     "line": 55,
     "text": "“是斯内普教授自己收走的，他那天心情不好。”"
    },
    {
     "id": "4-06",
     "line": 55,
     "text": "埃德蒙有点冤枉。"
    },
    {
     "id": "4-07",
     "line": 57,
     "text": "比尔笑得更厉害了。"
    },
    {
     "id": "4-08",
     "line": 59,
     "text": "笑完，他慢慢收了声，低头看着杯里的茶。"
    },
    {
     "id": "4-09",
     "line": 61,
     "text": "“说真的。”"
    },
    {
     "id": "4-10",
     "line": 63,
     "text": "“我这次来，不光是看你。”"
    }
   ]
  },
  {
   "no": 5,
   "label": "第65段起",
   "start_line": 65,
   "end_line": 79,
   "sentences": [
    {
     "id": "5-01",
     "line": 65,
     "text": "埃德蒙等着他说。"
    },
    {
     "id": "5-02",
     "line": 67,
     "text": "“我马上升七年级了。”"
    },
    {
     "id": "5-03",
     "line": 69,
     "text": "“下学期，我要当男学生会主席。”"
    },
    {
     "id": "5-04",
     "line": 71,
     "text": "比尔说这话的时候，语气很平，没什么炫耀的意思。"
    },
    {
     "id": "5-05",
     "line": 73,
     "text": "“往后，我得忙得脚不沾地。”"
    },
    {
     "id": "5-06",
     "line": 75,
     "text": "“上课、级长的事、学生会的事，还有家里那一堆弟弟妹妹。”"
    },
    {
     "id": "5-07",
     "line": 77,
     "text": "“查理那小子今年也要升六年级了，费尔奇天天盯着他们宿舍那层楼。”"
    },
    {
     "id": "5-08",
     "line": 79,
     "text": "“我妈的信里，一半在念叨我，一半在念叨他。”"
    }
   ]
  },
  {
   "no": 6,
   "label": "第81段起",
   "start_line": 81,
   "end_line": 95,
   "sentences": [
    {
     "id": "6-01",
     "line": 81,
     "text": "“我顾不过来了。”"
    },
    {
     "id": "6-02",
     "line": 83,
     "text": "埃德蒙没接话。"
    },
    {
     "id": "6-03",
     "line": 85,
     "text": "他听懂了。"
    },
    {
     "id": "6-04",
     "line": 87,
     "text": "比尔把茶杯放下，伸手拍了拍他的肩。"
    },
    {
     "id": "6-05",
     "line": 89,
     "text": "“我弟弟，查理。”"
    },
    {
     "id": "6-06",
     "line": 91,
     "text": "“格兰芬多的，打魁地奇的找球手。”"
    },
    {
     "id": "6-07",
     "line": 93,
     "text": "“你见过他，去年试训的时候，他给你拆过动作。”"
    },
    {
     "id": "6-08",
     "line": 95,
     "text": "埃德蒙点头。"
    }
   ]
  },
  {
   "no": 7,
   "label": "第97段起",
   "start_line": 97,
   "end_line": 99,
   "sentences": [
    {
     "id": "7-01",
     "line": 97,
     "text": "他记得那个红头发的少年，话不多，动作干净利落，给他示范过两次扫帚急停。"
    },
    {
     "id": "7-02",
     "line": 99,
     "text": "“他下学年还要兼队长。”"
    }
   ]
  }
 ]
}