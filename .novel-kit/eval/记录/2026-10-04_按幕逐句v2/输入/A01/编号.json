{
  "version": 1,
  "target": "A01",
  "source_hash": "5814fd130f1a6ce78ce2ca019210e2bb2f59f2b9be2c2f41cc959a9ace0c4c10",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "埃德蒙从随身布袋里掏出一口二号黄铜坩埚，全新的备用锅，昨晚在水房刷了三遍。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "托比倒抽一口冷气。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "“那是熬魔药的坩埚！”"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "“能受热的金属罐子，在厨房就是口锅。”"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "他从左袖口内袋摸出一张折得整齐的黄纸，指腹捻开。"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "纸是练字用的次等羊皮，墨色发暗，带一点药味。"
        },
        {
          "id": "1-07",
          "line": 11,
          "text": "天机库里那本民俗图谱的笔势他背得滚瓜烂熟，墨水是魔药课槽里舀的解毒剂底液，掺了烧焦的鼠尾草灰。"
        },
        {
          "id": "1-08",
          "line": 11,
          "text": "这几周他废了十几张，能用的只有三张。"
        },
        {
          "id": "1-09",
          "line": 13,
          "text": "昨晚一整晚的功夫全灌进了这一张，一点都没进手机。"
        },
        {
          "id": "1-10",
          "line": 15,
          "text": "他把黄纸啪的一声贴在坩埚底部。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 21,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "微弱的金芒泛开，铜锅底升起一股不高不低的暖意。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "它不吃咒，吃的是空气里散漫的那股魔力。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "托比盯着那张纸，比盯着锅还久。"
        }
      ]
    }
  ]
}