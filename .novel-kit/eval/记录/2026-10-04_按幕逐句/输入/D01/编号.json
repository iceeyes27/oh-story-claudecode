{
  "version": 1,
  "target": "D01",
  "source_hash": "eab6c3dc4f2cc7dc39864d96eb7d1e9eeb5206120bb73cf8e56cb277e389eed8",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "一只戴着厚皮手套的右手，在半空中稳稳合拢。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "细小的金色翅膀在指缝间剧烈扑腾。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "赫奇帕奇找球手的扫帚擦着草皮滑出十几码，犁出一道深深的泥沟，随后高高扬起了手臂。"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "球场陷入了死一般的寂静。"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "紧接着，霍琦女士嘴里的银哨发出了长长的一声尖啸。"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "“赫奇帕奇抓到了金色飞贼！”"
        },
        {
          "id": "1-07",
          "line": 13,
          "text": "“二百四十比一百！"
        },
        {
          "id": "1-08",
          "line": 13,
          "text": "赫奇帕奇获胜！”"
        },
        {
          "id": "1-09",
          "line": 15,
          "text": "看台彻底沸腾了。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "黄黑色的围巾和尖顶帽像潮水般被抛上半空。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "整个赫奇帕奇学院的学生发疯一样翻过栏杆，朝球场正中涌去。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "斯莱特林的球员瘫坐在泥水里，马尔科姆死死盯着那只被高举的金色飞贼，面色灰败得像一块抹布。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "在格兰芬多的看台上，查理・韦斯莱用力拍着手掌，嘴角挂着笑意。"
        },
        {
          "id": "2-05",
          "line": 25,
          "text": "一年级的奥利弗・伍德跳上椅子，手里拿着羊皮纸冲同伴大喊："
        },
        {
          "id": "2-06",
          "line": 27,
          "text": "“看见没有！"
        },
        {
          "id": "2-07",
          "line": 27,
          "text": "那是切线！"
        },
        {
          "id": "2-08",
          "line": 27,
          "text": "我就说那个角度能切进去！”"
        },
        {
          "id": "2-09",
          "line": 29,
          "text": "喧闹的人潮中，主宾席上的邓布利多缓缓站起身。"
        },
        {
          "id": "2-10",
          "line": 31,
          "text": "半月形的镜片后，那双湛蓝的眼睛穿过欢呼雀跃的年轻巫师，在退到替补席阴影里的埃德蒙身上停顿了片刻。"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 47,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "埃德蒙没有往前挤。"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "他悄悄顺着人群后方的通道，往城堡大门走。"
        },
        {
          "id": "3-03",
          "line": 37,
          "text": "“等等我！”"
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "小满从侧面石阶上追下来，额前的碎发被汗水粘在脸上。"
        },
        {
          "id": "3-05",
          "line": 41,
          "text": "她眼眸亮得吓人。"
        },
        {
          "id": "3-06",
          "line": 43,
          "text": "“你刚才那一嗓子……"
        },
        {
          "id": "3-07",
          "line": 43,
          "text": "你是不是早就知道飞贼会往哪儿飞？”"
        },
        {
          "id": "3-08",
          "line": 45,
          "text": "“你会预知？”"
        },
        {
          "id": "3-09",
          "line": 47,
          "text": "埃德蒙放慢了脚步。"
        }
      ]
    },
    {
      "no": 4,
      "label": "第49段起",
      "start_line": 49,
      "end_line": 63,
      "sentences": [
        {
          "id": "4-01",
          "line": 49,
          "text": "“不会。”"
        },
        {
          "id": "4-02",
          "line": 51,
          "text": "他把双手揣进袍袖。"
        },
        {
          "id": "4-03",
          "line": 53,
          "text": "“我会算。”"
        },
        {
          "id": "4-04",
          "line": 55,
          "text": "小满抿了抿嘴唇，没再继续追问，但那双眼睛里的神色分明已经彻底变了。"
        },
        {
          "id": "4-05",
          "line": 57,
          "text": "袖底微微一热，傻妞轻快的声音悄悄响起来："
        },
        {
          "id": "4-06",
          "line": 59,
          "text": "“报告老板，赫奇帕奇胜率提升了百分之八十呢！”"
        },
        {
          "id": "4-07",
          "line": 61,
          "text": "“不过老板，俗话说木秀于林，风必摧之，咱们待会儿是不是悄悄溜走比较好呀？”"
        },
        {
          "id": "4-08",
          "line": 63,
          "text": "埃德蒙轻声接话："
        }
      ]
    },
    {
      "no": 5,
      "label": "第65段起",
      "start_line": 65,
      "end_line": 71,
      "sentences": [
        {
          "id": "5-01",
          "line": 65,
          "text": "“这句鲁迅说的。”"
        },
        {
          "id": "5-02",
          "line": 67,
          "text": "“老板，经傻妞查证，这句出自三国时期李康的运命论，鲁迅先生没说过哦，老板又想蒙傻妞啦，嘻嘻。”"
        },
        {
          "id": "5-03",
          "line": 69,
          "text": "埃德蒙踩着石阶往城堡走，目光扫过远处斯莱特林更衣室紧闭的大门。"
        },
        {
          "id": "5-04",
          "line": 71,
          "text": "“穿长衫站着喝酒，体面是体面，就是有点冷。”"
        }
      ]
    }
  ]
}