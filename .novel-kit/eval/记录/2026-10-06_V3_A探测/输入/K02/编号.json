{
 "version": 1,
 "target": "K02",
 "source_hash": "88dc189a6d850e49a64bc5a1d21613ec502e91f01307f5bfec0aa4a0e4c0167a",
 "beats": [
  {
   "no": 1,
   "label": "第3段起",
   "start_line": 1,
   "end_line": 17,
   "sentences": [
    {
     "id": "1-01",
     "line": 3,
     "text": "傍晚的木门，吱呀一声推开。"
    },
    {
     "id": "1-02",
     "line": 5,
     "text": "亚瑟半个身子先靠在门框上。"
    },
    {
     "id": "1-03",
     "line": 7,
     "text": "手里那只魔法部的旧公文包，从指间滑下去，被他用胳肢窝夹住。"
    },
    {
     "id": "1-04",
     "line": 9,
     "text": "另一只手，死死按着左膝盖。"
    },
    {
     "id": "1-05",
     "line": 11,
     "text": "他脸上还挂着下班路上那点僵的笑，进门先往灶台那边看。"
    },
    {
     "id": "1-06",
     "line": 13,
     "text": "“回来啦。”"
    },
    {
     "id": "1-07",
     "line": 15,
     "text": "母亲在灶边，头也没抬。"
    },
    {
     "id": "1-08",
     "line": 17,
     "text": "“你爸的膝盖又疼了。”"
    }
   ]
  },
  {
   "no": 2,
   "label": "第19段起",
   "start_line": 19,
   "end_line": 33,
   "sentences": [
    {
     "id": "2-01",
     "line": 19,
     "text": "一句话，平平的，像说过很多遍。"
    },
    {
     "id": "2-02",
     "line": 21,
     "text": "亚瑟赶紧摆手：“没事没事，老毛病。”"
    },
    {
     "id": "2-03",
     "line": 23,
     "text": "“焐一焐就好。”"
    },
    {
     "id": "2-04",
     "line": 25,
     "text": "话没说完，他嘶地抽了口气。"
    },
    {
     "id": "2-05",
     "line": 27,
     "text": "按着膝盖的那只手，指节都白了。"
    },
    {
     "id": "2-06",
     "line": 29,
     "text": "埃德蒙从凳子上站起来。"
    },
    {
     "id": "2-07",
     "line": 31,
     "text": "他先过去，把父亲胳膊下那只公文包接过来，搁到桌上。"
    },
    {
     "id": "2-08",
     "line": 33,
     "text": "包里哗啦一响，是文件。"
    }
   ]
  },
  {
   "no": 3,
   "label": "第35段起",
   "start_line": 35,
   "end_line": 49,
   "sentences": [
    {
     "id": "3-01",
     "line": 35,
     "text": "“爸，先坐下。”"
    },
    {
     "id": "3-02",
     "line": 37,
     "text": "亚瑟被儿子扶了一把，有点不自在，嘴里还在逞强。"
    },
    {
     "id": "3-03",
     "line": 39,
     "text": "“我自己能走。”"
    },
    {
     "id": "3-04",
     "line": 41,
     "text": "“我又不是动不了的老古董。”"
    },
    {
     "id": "3-05",
     "line": 43,
     "text": "话是这么说，那条伤腿迈过门槛的时候，还是颠了一下。"
    },
    {
     "id": "3-06",
     "line": 45,
     "text": "埃德蒙没戳穿他。"
    },
    {
     "id": "3-07",
     "line": 47,
     "text": "母亲往壶底添了把火，又去揉她的面团。"
    },
    {
     "id": "3-08",
     "line": 49,
     "text": "亚瑟在椅子上坐下，那只伤腿僵直地伸着，不敢弯。"
    }
   ]
  },
  {
   "no": 4,
   "label": "第51段起",
   "start_line": 51,
   "end_line": 61,
   "sentences": [
    {
     "id": "4-01",
     "line": 51,
     "text": "“真不用。”"
    },
    {
     "id": "4-02",
     "line": 53,
     "text": "他还在嘴硬。"
    },
    {
     "id": "4-03",
     "line": 55,
     "text": "“你忙你的，过会儿就好了。”"
    },
    {
     "id": "4-04",
     "line": 57,
     "text": "埃德蒙没接话。"
    },
    {
     "id": "4-05",
     "line": 59,
     "text": "他转身去墙角的水缸里舀水，倒进铜壶，架上灶。"
    },
    {
     "id": "4-06",
     "line": 61,
     "text": "灶火舔着壶底，水声渐渐响起来。"
    }
   ]
  }
 ]
}