{
  "version": 1,
  "target": "K01",
  "source_hash": "68bc3dfcea62896bc45b1f5691051914f8397ad760b0b71fbc485de4f8e380e1",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "母亲玛莎坐在窗边的小桌前，背对着门。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "她头上别着一根旧木簪，肩头落着几根线头。"
        },
        {
          "id": "1-03",
          "line": 5,
          "text": "右手那枚黄铜顶针，正压在一件翻了一半的黑袍子上。"
        },
        {
          "id": "1-04",
          "line": 7,
          "text": "“回来了？”"
        },
        {
          "id": "1-05",
          "line": 9,
          "text": "她没回头，手里的针还在走。"
        },
        {
          "id": "1-06",
          "line": 11,
          "text": "“先坐，妈把这两针缝完。”"
        },
        {
          "id": "1-07",
          "line": 13,
          "text": "埃德蒙把皮箱搁在墙角，没出声。"
        },
        {
          "id": "1-08",
          "line": 15,
          "text": "他打量这间住了十一年的屋子。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "墙还是那面墙，水渍从天花板一直爬到窗框。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "窗下那张小桌上，旧袍堆成小山，发暗校袍、磨毛斗篷一件件叠着。"
        },
        {
          "id": "2-03",
          "line": 21,
          "text": "桌角压着几枚小小的银币，少得可怜。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "母亲缝完最后一针，咬断线头，这才转过身。"
        },
        {
          "id": "2-05",
          "line": 25,
          "text": "她眼底有掩不住的倦，笑起来却很软。"
        },
        {
          "id": "2-06",
          "line": 27,
          "text": "“瘦了。”"
        },
        {
          "id": "2-07",
          "line": 29,
          "text": "她伸手想摸他的脸，半道又在围裙上擦了擦手。"
        },
        {
          "id": "2-08",
          "line": 31,
          "text": "“学校吃得饱不饱？”"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 47,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "“饱。”"
        },
        {
          "id": "3-02",
          "line": 35,
          "text": "埃德蒙看着她那只手。"
        },
        {
          "id": "3-03",
          "line": 37,
          "text": "指腹上一层厚厚的旧茧，指甲缝里嵌着洗不净的靛色浆痕。"
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "那枚黄铜顶针磨得发亮，边缘的小坑都平了。"
        },
        {
          "id": "3-05",
          "line": 41,
          "text": "他袖底极轻地震了一下。"
        },
        {
          "id": "3-06",
          "line": 43,
          "text": "冷玉屏亮起一线微光，只有他自己看得见。"
        },
        {
          "id": "3-07",
          "line": 45,
          "text": "底栏滑过一行小字。"
        },
        {
          "id": "3-08",
          "line": 47,
          "text": "“老板，玛莎女士手腕的旧酸又犯了，右腕比左腕肿着一点。”"
        }
      ]
    },
    {
      "no": 4,
      "label": "第49段起",
      "start_line": 49,
      "end_line": 63,
      "sentences": [
        {
          "id": "4-01",
          "line": 49,
          "text": "“待会儿建议您用温水符给她焐一焐哦。”"
        },
        {
          "id": "4-02",
          "line": 51,
          "text": "埃德蒙指尖在袖底轻轻一按，算作应下。"
        },
        {
          "id": "4-03",
          "line": 53,
          "text": "他拉了张矮凳，坐到小桌旁。"
        },
        {
          "id": "4-04",
          "line": 55,
          "text": "“妈，这些袍子，一件给你多少？”"
        },
        {
          "id": "4-05",
          "line": 57,
          "text": "“黑袍子两个西可，斗篷三个。”"
        },
        {
          "id": "4-06",
          "line": 59,
          "text": "母亲把缝好的袍子叠起来，动作很轻。"
        },
        {
          "id": "4-07",
          "line": 61,
          "text": "“看着多，其实不值钱。”"
        },
        {
          "id": "4-08",
          "line": 63,
          "text": "“一个月从早忙到晚，也凑不出半条新袍子的料。”"
        }
      ]
    },
    {
      "no": 5,
      "label": "第65段起",
      "start_line": 65,
      "end_line": 67,
      "sentences": [
        {
          "id": "5-01",
          "line": 65,
          "text": "埃德蒙伸手摸了摸那件旧校袍。"
        },
        {
          "id": "5-02",
          "line": 67,
          "text": "浆过的地方发硬，里子皱着，一看就不服帖。"
        }
      ]
    }
  ]
}