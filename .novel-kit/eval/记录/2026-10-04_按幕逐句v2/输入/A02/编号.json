{
  "version": 1,
  "target": "A02",
  "source_hash": "a4bad6d8bcbd411db95f63a9f28e5f7a1d0c78d946646cf36775f4d48722c97d",
  "beats": [
    {
      "no": 1,
      "label": "第1段起",
      "start_line": 1,
      "end_line": 15,
      "sentences": [
        {
          "id": "1-01",
          "line": 1,
          "text": "埃德蒙叹了口气，从袖口把手机亮出来，顺手滑进深灰色的龙皮套里。"
        },
        {
          "id": "1-02",
          "line": 3,
          "text": "“不是黑魔法。"
        },
        {
          "id": "1-03",
          "line": 3,
          "text": "家传的东方法器，里头有长辈留下的一点灵识。"
        },
        {
          "id": "1-04",
          "line": 3,
          "text": "东方的术法我只略懂皮毛。”"
        },
        {
          "id": "1-05",
          "line": 5,
          "text": "“你一个英国混血，哪来的法器。”"
        },
        {
          "id": "1-06",
          "line": 7,
          "text": "姜小满狐疑地打量着那块温润的墨晶镜片，又死死盯住他的左边袖口，耳根悄悄泛起一抹浅红。"
        },
        {
          "id": "1-07",
          "line": 9,
          "text": "“那你呢。”"
        },
        {
          "id": "1-08",
          "line": 9,
          "text": "埃德蒙反问，“姜同学，除了伦敦腔，你父亲还教过你什么。”"
        },
        {
          "id": "1-09",
          "line": 11,
          "text": "姜小满的脸色变了。"
        },
        {
          "id": "1-10",
          "line": 13,
          "text": "她咬着下唇，从衣领里拽出一枚古旧铜牌，上头刻着四个小篆：姜记奇宝。"
        },
        {
          "id": "1-11",
          "line": 15,
          "text": "接着，她从书页里抽出一张残破泛黄的宣纸。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第17段起",
      "start_line": 17,
      "end_line": 31,
      "sentences": [
        {
          "id": "2-01",
          "line": 17,
          "text": "上面画着一道苍劲的符线，底端收束成八卦回纹。"
        },
        {
          "id": "2-02",
          "line": 19,
          "text": "埃德蒙的目光凝住了。"
        },
        {
          "id": "2-03",
          "line": 19,
          "text": "那个起笔的架构，和他贴在锅底那张出自同一种画法。"
        },
        {
          "id": "2-04",
          "line": 21,
          "text": "“你认得。”"
        },
        {
          "id": "2-05",
          "line": 23,
          "text": "姜小满的声音有点发颤。"
        },
        {
          "id": "2-06",
          "line": 25,
          "text": "“我父亲失踪前留下的笔记被火烧了，就剩这一页。"
        },
        {
          "id": "2-07",
          "line": 25,
          "text": "这两年我给谁看都没人认得。"
        },
        {
          "id": "2-08",
          "line": 25,
          "text": "可你贴在锅底那张纸，起笔的线和它一模一样。”"
        },
        {
          "id": "2-09",
          "line": 27,
          "text": "她深吸一口气。"
        },
        {
          "id": "2-10",
          "line": 29,
          "text": "“做个交易。"
        },
        {
          "id": "2-11",
          "line": 29,
          "text": "你的秘密我不告诉任何人，但你得帮我查清这半页纸上画的是什么。”"
        },
        {
          "id": "2-12",
          "line": 31,
          "text": "埃德蒙看着那张递过来的残页，和那双不肯移开的眼睛。"
        }
      ]
    },
    {
      "no": 3,
      "label": "第33段起",
      "start_line": 33,
      "end_line": 33,
      "sentences": [
        {
          "id": "3-01",
          "line": 33,
          "text": "“成交。”"
        }
      ]
    }
  ]
}