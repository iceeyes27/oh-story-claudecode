{
  "version": 1,
  "target": "C01",
  "source_hash": "0a92d3c15cdc4ac2bf13c6a0c6a5812360fc0f5785a4c2c413fff0d446c39c4c",
  "beats": [
    {
      "no": 1,
      "label": "第3段起",
      "start_line": 1,
      "end_line": 17,
      "sentences": [
        {
          "id": "1-01",
          "line": 3,
          "text": "玛莎第三次把那个麻布药包塞进他的大衣内袋，手停在半空，没松开。"
        },
        {
          "id": "1-02",
          "line": 5,
          "text": "“早晚各泡一次。”"
        },
        {
          "id": "1-03",
          "line": 7,
          "text": "她拽着他的袖口，指节上是常年翻新旧袍磨出的茧。"
        },
        {
          "id": "1-04",
          "line": 9,
          "text": "“胸口发闷就别扛着，去找校医。”"
        },
        {
          "id": "1-05",
          "line": 11,
          "text": "“知道了，妈。”"
        },
        {
          "id": "1-06",
          "line": 13,
          "text": "九又四分之三站台上白雾翻涌，猩红的蒸汽列车卧在铁轨中间，汽笛长鸣。"
        },
        {
          "id": "1-07",
          "line": 15,
          "text": "亚瑟扶着那口皮箱，一路上没怎么说话。"
        },
        {
          "id": "1-08",
          "line": 17,
          "text": "那天夜里之后，这两口子跟他讲话就变得小心。"
        },
        {
          "id": "1-09",
          "line": 17,
          "text": "就连问他要不要加一块面包，也得问两遍才把话说完整。"
        }
      ]
    },
    {
      "no": 2,
      "label": "第19段起",
      "start_line": 19,
      "end_line": 33,
      "sentences": [
        {
          "id": "2-01",
          "line": 19,
          "text": "哨声催客的时候，亚瑟才伸出手来，把两枚硬币摁进他掌心。"
        },
        {
          "id": "2-02",
          "line": 21,
          "text": "“路上买点吃的。”"
        },
        {
          "id": "2-03",
          "line": 23,
          "text": "两个西可。"
        },
        {
          "id": "2-04",
          "line": 23,
          "text": "埃德蒙捏着它们，想起阁楼床头那根劈了缝的旧木棍，也是两个西可。"
        },
        {
          "id": "2-05",
          "line": 25,
          "text": "“魔杖收好，别磕碰。”"
        },
        {
          "id": "2-06",
          "line": 27,
          "text": "玛莎从他衣襟里抽出裹了三层旧布的新魔杖，又给他别回腰间。"
        },
        {
          "id": "2-07",
          "line": 29,
          "text": "昨晚在对角巷，那家店的老头把三十几个盒子堆上柜台。"
        },
        {
          "id": "2-08",
          "line": 29,
          "text": "父亲淘的那根旧货一进他手里，火星都引不出一颗。"
        },
        {
          "id": "2-09",
          "line": 29,
          "text": "最后落进他掌心的这根，一下子就发了烫。"
        },
        {
          "id": "2-10",
          "line": 31,
          "text": "白胡子老头捏着杖身追到门口，冲亚瑟的背影喊。"
        },
        {
          "id": "2-11",
          "line": 33,
          "text": "“他自己挑的，说它认主。"
        },
        {
          "id": "2-12",
          "line": 33,
          "text": "头一个学期，就指着它了。”"
        }
      ]
    },
    {
      "no": 3,
      "label": "第35段起",
      "start_line": 35,
      "end_line": 49,
      "sentences": [
        {
          "id": "3-01",
          "line": 35,
          "text": "车尾那节他找到个空隔间，把皮箱推上行李架，拉门坐下，才从内袋里摸出手机。"
        },
        {
          "id": "3-02",
          "line": 37,
          "text": "机身裹在一只翻盖皮套里，玛莎用改袍子剩下的二手龙皮料头缝的，配了个亚瑟淘来的铜扣，皮面上那圈云纹是他自己描的。"
        },
        {
          "id": "3-03",
          "line": 39,
          "text": "他描云纹的手，也是午休趴在工位描了一夏天符箓图谱的手。"
        },
        {
          "id": "3-04",
          "line": 39,
          "text": "十年攒下的《哈利·波特》设定笔记，早被他一股脑喂进了这台公司机的本地库。"
        },
        {
          "id": "3-05",
          "line": 39,
          "text": "那会儿纯解闷，做梦也没想过会真用上。"
        },
        {
          "id": "3-06",
          "line": 41,
          "text": "拨开铜扣，屏幕泛起一点微光，右上角那个电池图标标着0.2%。"
        },
        {
          "id": "3-07",
          "line": 43,
          "text": "“傻妞，能撑到晚上熄灯吗。”"
        },
        {
          "id": "3-08",
          "line": 43,
          "text": "他把声音压到最低。"
        },
        {
          "id": "3-09",
          "line": 45,
          "text": "机身轻微一颤，屏幕底端浮出一行极细的绿字，扬声器里跟着传出一道压得极轻的气音："
        },
        {
          "id": "3-10",
          "line": 47,
          "text": "“正在维持超低功耗模式……"
        },
        {
          "id": "3-11",
          "line": 47,
          "text": "勉强可以撑到熄灯。"
        },
        {
          "id": "3-12",
          "line": 47,
          "text": "老板，根据预设防护条例，对外的口径是：东方来的家传法器，您只略懂皮毛。”"
        },
        {
          "id": "3-13",
          "line": 49,
          "text": "“记牢了。”"
        }
      ]
    },
    {
      "no": 4,
      "label": "第51段起",
      "start_line": 51,
      "end_line": 65,
      "sentences": [
        {
          "id": "4-01",
          "line": 51,
          "text": "这口径是他昨晚临睡前定的。"
        },
        {
          "id": "4-02",
          "line": 51,
          "text": "破阁楼里爬出来的魔法孤儿，怀里揣个会发光的洋盒子，不编个家传法器的由头，进了校门就得被人围着当怪物。"
        },
        {
          "id": "4-03",
          "line": 53,
          "text": "“车厢收音环境杂乱，周围有人，请您尽量不要自言自语，会被当成奇怪的人哦。”"
        },
        {
          "id": "4-04",
          "line": 55,
          "text": "他默念了两遍，包厢门哗啦一声被人拽开。"
        },
        {
          "id": "4-05",
          "line": 57,
          "text": "门轨卡了半道，外面那人使劲一推，整个人趔趄着撞进来。"
        },
        {
          "id": "4-06",
          "line": 59,
          "text": "“哎哟我的妈。”"
        },
        {
          "id": "4-07",
          "line": 61,
          "text": "一句中文。"
        },
        {
          "id": "4-08",
          "line": 63,
          "text": "门口立着个黑发女孩，马尾扎得利落，套着一件明显大一号的新黑袍，手里拎着个小藤箱。"
        },
        {
          "id": "4-09",
          "line": 65,
          "text": "她抬起头，正撞见他对着口袋动嘴皮子的脸。"
        }
      ]
    },
    {
      "no": 5,
      "label": "第67段起",
      "start_line": 67,
      "end_line": 81,
      "sentences": [
        {
          "id": "5-01",
          "line": 67,
          "text": "“你在跟谁说话？”"
        },
        {
          "id": "5-02",
          "line": 69,
          "text": "“练发音呢。"
        },
        {
          "id": "5-03",
          "line": 69,
          "text": "刚背的咒语太拗口，舌头总倒不过来。”"
        },
        {
          "id": "5-04",
          "line": 71,
          "text": "女孩把箱子往座底一推，坐下了，眼睛却没从他膝头那块皮套上挪开。"
        },
        {
          "id": "5-05",
          "line": 73,
          "text": "“哪个咒。”"
        },
        {
          "id": "5-06",
          "line": 75,
          "text": "“啊？”"
        },
        {
          "id": "5-07",
          "line": 77,
          "text": "“你刚才念的是哪个咒。”"
        },
        {
          "id": "5-08",
          "line": 77,
          "text": "她抱起胳膊，“一年级的咒语我开学前全背完了。"
        },
        {
          "id": "5-09",
          "line": 77,
          "text": "没有一个是那个调。”"
        },
        {
          "id": "5-10",
          "line": 79,
          "text": "埃德蒙把手机翻了个面扣在膝上，露出深灰的龙皮纹。"
        },
        {
          "id": "5-11",
          "line": 81,
          "text": "“家里传的东西，上头有字。"
        },
        {
          "id": "5-12",
          "line": 81,
          "text": "我照着念。”"
        }
      ]
    },
    {
      "no": 6,
      "label": "第83段起",
      "start_line": 83,
      "end_line": 97,
      "sentences": [
        {
          "id": "6-01",
          "line": 83,
          "text": "“什么字。”"
        },
        {
          "id": "6-02",
          "line": 85,
          "text": "他低头瞥了眼膝头的皮套，缝里那道极细的屏光一闪，把对面那女孩的名姓送进他眼里。"
        },
        {
          "id": "6-03",
          "line": 87,
          "text": "他换了中文。"
        },
        {
          "id": "6-04",
          "line": 89,
          "text": "“小满同学，你刚才那句，说得挺地道。”"
        },
        {
          "id": "6-05",
          "line": 91,
          "text": "女孩身形一僵。"
        },
        {
          "id": "6-06",
          "line": 93,
          "text": "她张了张嘴，后半截盘问咽了回去，抿着嘴唇往后靠。"
        },
        {
          "id": "6-07",
          "line": 95,
          "text": "“……"
        },
        {
          "id": "6-08",
          "line": 95,
          "text": "你会中文？”"
        },
        {
          "id": "6-09",
          "line": 97,
          "text": "她用伦敦腔的中文问，下巴微微扬起来。"
        }
      ]
    },
    {
      "no": 7,
      "label": "第99段起",
      "start_line": 99,
      "end_line": 99,
      "sentences": [
        {
          "id": "7-01",
          "line": 99,
          "text": "“略懂一点。”"
        }
      ]
    }
  ]
}